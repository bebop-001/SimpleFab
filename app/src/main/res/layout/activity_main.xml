<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="16dp"
    tools:ignore="HardcodedText">

    <com.example.myapp.SimpleFab
        android:id="@+id/simple_fab_1"
        android:layout_width="56dp"
        android:layout_height="56dp"
        app:bgSrc="@drawable/fab_purple_background"
        app:flow_lastVerticalBias="0.3"

        app:iconSrc="@drawable/ic_add_24"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.5"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.3" />

    <Button
        android:id="@+id/show_button_1"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Show"
        app:layout_constraintEnd_toStartOf="@+id/hide_button_1"
        app:layout_constraintHorizontal_bias="0.5"
        app:layout_constraintHorizontal_chainStyle="spread"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/simple_fab_1"
        />

    <Button
        android:id="@+id/hide_button_1"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Hide"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/show_button_1"
        app:layout_constraintTop_toBottomOf="@id/simple_fab_1"
        />


    <com.example.myapp.SimpleFab
        android:id="@+id/simple_fab_2"
        android:layout_width="56dp"
        android:layout_height="56dp"
        app:bgSrc="@drawable/fab_orange_background"
        app:flow_lastVerticalBias="0.3"

        app:iconSrc="@drawable/ic_add_24"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.5"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.5" />

    <Button
        android:id="@+id/show_button_2"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Show"
        app:layout_constraintEnd_toStartOf="@+id/hide_button_2"
        app:layout_constraintHorizontal_bias="0.5"
        app:layout_constraintHorizontal_chainStyle="spread"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/simple_fab_2"
        />

    <Button
        android:id="@+id/hide_button_2"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Hide"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/show_button_2"
        app:layout_constraintTop_toBottomOf="@id/simple_fab_2"
        />





</androidx.constraintlayout.widget.ConstraintLayout>
